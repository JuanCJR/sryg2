# Copy to .env at the repo root. Never commit .env.
NODE_ENV=development
PORT=3000

# Local docker compose database (pnpm db:up). Use Neon URLs (sslmode=require) in production.
DATABASE_URL=postgres://sryg:sryg@localhost:5432/sryg
# Direct (unpooled) connection used for migrations; same as DATABASE_URL locally.
DATABASE_MIGRATION_URL=postgres://sryg:sryg@localhost:5432/sryg

# At least 32 bytes.
JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes
JWT_TTL_SECONDS=3600

# Comma-separated exact origins.
CORS_ORIGIN=http://localhost:5173

# Only needed by `pnpm db:seed:admin` (initial administrator; safe to re-run). All three are required.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Optional, for `pnpm db:seed` (fictitious development data, D25; refuses NODE_ENV=production).
# SEED_RANDOM fixes the data set (default 2026); SEED_TODAY anchors expiry dates (default: today).
# SEED_USERS_PASSWORD is shared by the nine demo users (default: sryg-demo-2026).
SEED_RANDOM=
SEED_TODAY=
SEED_USERS_PASSWORD=
